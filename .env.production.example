# ========================================================
# EdSecure Hub - PRODUCTION Environment Configuration
# ========================================================
# ⚠️  NEVER commit this file. Copy from .env.production.example
#     and fill in real values on the production server.
#
# Location on server: /opt/edsecure/.env
# ========================================================

# ── Server Runtime ────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Authentication & Security ─────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# ── PostgreSQL Database ───────────────────────────────────
POSTGRES_USER=edsecure_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=edsecure_db
DATABASE_URL=postgresql://edsecure_admin:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/edsecure_db?sslmode=require

# ── Redis Cache ───────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# ── Application ──────────────────────────────────────────
PLATFORM_BASE_URL=https://edsecure.example.com
NATIONAL_HELPLINE=1930

# ── Docker Image ─────────────────────────────────────────
EDSECURE_IMAGE=ghcr.io/your-org/ed-secure-hub:latest

# ── Backup Configuration (for scripts/backup.sh) ─────────
BACKUP_DIR=/mnt/backups/postgres
BACKUP_RETENTION=30
# S3_BUCKET=your-backup-bucket-name
# WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
