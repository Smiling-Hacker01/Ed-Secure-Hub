# ========================================================
# EdSecure Hub - Environment Configuration Template
# ========================================================

# Server Runtime
NODE_ENV=development
PORT=3000

# Authentication & Security
# Generate a high-entropy 256-bit string for production (e.g. openssl rand -base64 32)
JWT_SECRET=edsecure_super_secure_production_secret_key_2026_at_least_32_chars

# Database Configuration (PostgreSQL)
# When unset in local dev, platform uses zero-config self-persisting store (.data/edsecure_store.json)
DATABASE_URL=postgresql://edsecure_admin:EdSecure_Postgres_Password_2026@localhost:5432/edsecure_db?sslmode=disable

# Redis Cache / Background Workers
REDIS_URL=redis://localhost:6379

# Emergency Hotlines & Platform Integrations
NATIONAL_HELPLINE=1930
PLATFORM_BASE_URL=http://localhost:3000
