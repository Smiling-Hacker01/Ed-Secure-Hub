# ========================================================
# EdSecure Hub - Environment Configuration Template
# ========================================================

# Server Runtime
NODE_ENV=development
PORT=3000

# Authentication & Security
# Generate a high-entropy 256-bit string for production (e.g. openssl rand -base64 32)
JWT_SECRET=edsecure_super_secure_production_secret_key_2026_at_least_32_chars

# Database Configuration (PostgreSQL)
# Set DATABASE_URL to store all application records in PostgreSQL.
# If unset, local development uses .data/edsecure_store.json instead.
DATABASE_URL=
# Optional base64-encoded PostgreSQL CA certificate for providers that require it.
DATABASE_SSL_CA_BASE64=

# Redis Cache / Background Workers
REDIS_URL=redis://localhost:6379

# Emergency Hotlines & Platform Integrations
NATIONAL_HELPLINE=1930
PLATFORM_BASE_URL=http://localhost:3000
